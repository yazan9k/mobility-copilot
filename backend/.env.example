# Copy to backend/.env and adjust if your setup differs.
#
# This project runs entirely on local models via Ollama, so there are no API
# keys and nothing here is secret. The file exists because config is config,
# and because swapping to a hosted provider later means adding a key here
# rather than restructuring anything.

OLLAMA_HOST=http://localhost:11434

# Models. Both must be pulled:  ollama pull qwen2.5:7b && ollama pull qwen2.5:14b
AGENT_MODEL=qwen2.5:7b
JUDGE_MODEL=qwen2.5:14b

# If you later switch agent/llm.py to a hosted provider, the key goes here.
# Never commit the real .env.
# ANTHROPIC_API_KEY=sk-ant-...
